
# --- Accounts ---
# Passwords live in secrets.env (chmod 600), not here. Both files are listed in
# env_file: of the compose services, so entrypoint.sh still sees them all.
SMB_READ_USER=readonly
# Writer account: files are owned by SMB_UID/SMB_GID; Match the host user that owns the share folders (id -u / id -g)
SMB_WRITE_USER=groot
# SMB_UID/SMB_GID must match the host user running Docker (id -u / id -g).
# Note: GID 20 resolves to the existing group "dialout" on Alpine, so shares end
# up with `force group = dialout`. Harmless, see docs/configuration.md#uidgid.
SMB_UID=501
SMB_GID=20

# --- Network ---
# 0.0.0.0 publishes port 445 on every host interface, i.e. reachable from the LAN.
# Set it to 127.0.0.1 to restrict access to this machine only.
SMB_BIND_IP=0.0.0.0
SMB_HOST_PORT=445
# Admin API (smb-admin): Docker binds 127.0.0.1:<this port> on the host and maps it
# to port 8333 inside the container. The bind address is hardcoded to 127.0.0.1 in
# compose.yaml so it can never be misconfigured onto the LAN.
ADMIN_API_PORT=444

# Samba server configuration. Contains credentials: keep it chmod 600 and out of version control.
# --- Image ---
# Project name = compose's identity for this stack. Deliberately NOT "on-premise"
# anymore: the previously running container (now stopped and renamed
# "original-smb") still carries the labels project=on-premise, service=samba, and
# compose matches containers by those labels, not by name. Under a different
# project name this stack cannot touch that container, so it stays as a rollback
# point. Rename it back once this stack is accepted.
COMPOSE_PROJECT_NAME=test
# Upstream base image, pinned by digest; passed to the Dockerfile as BASE_IMAGE
SMB_BASE_IMAGE=dockurr/samba:4.23.8@sha256:9e4dd0594f2f023c48b752519be2846ae193e75b7ef462c037435eac4b835dc2
# Tag of the locally built image (base + entrypoint.sh). Bump when SMB_BASE_IMAGE changes.
SMB_IMAGE=onpremise/samba:4.23.8
SMB_CONTAINER_NAME=smb-pod
SMB_HOSTNAME=sambanh
# Tag of the locally built Admin API image (./admin). Bump when admin/*.go changes
# in a way worth versioning; `./smb.sh up` rebuilds it either way.
ADMIN_IMAGE=onpremise/smb-admin:0.1.0
SMB_RESTART_POLICY=unless-stopped
TZ=Asia/Ho_Chi_Minh

# --- Runtime state ---
# Mount point of the "samba_core" named volume inside the container. Holds the
# declarative state written at runtime by smbctl: dynamic.conf (share blocks that
# entrypoint.sh `include`s at the end of smb.conf) and accounts.tsv (users +
# group membership replayed at every start). Survives down/up and
# --force-recreate; removed only by `docker compose down -v`.
# Back it up with: ./smb.sh state export <dir>
SMB_STATE_DIR=/var/lib/samba/state

# --- Protocol ---
SMB_WORKGROUP=WORKGROUP
SMB_SERVER_STRING=SBM service
SMB_NETBIOS_NAME=SMBSERVER
SMB_SERVER_MIN_PROTOCOL=SMB2_10
SMB_SERVER_MAX_PROTOCOL=SMB3
# default | auto | mandatory | disabled
SMB_SERVER_SIGNING=default
# off | if_required | desired | required
SMB_ENCRYPT=if_required
SMB_VFS_OBJECTS=catia fruit streams_xattr
# If the host folder rejects xattrs: drop streams_xattr above, set these to "no" and "netatalk"
SMB_EA_SUPPORT=yes
SMB_FRUIT_METADATA=stream

# --- Logging ---
# SMB_*: smbd's own log (connection/auth/share detail, verbosity via SMB_LOG_LEVEL). CONTAINER_LOG_*: the entrypoint's own stdout/stderr (startup/account/warning messages)
# falling back to the SMB_LOG_VOLUME named volume if that path is unusable.
SMB_LOG_HOST_PATH=/Volumes/RAMDisk/SMB/log
SMB_LOG_VOLUME=samba_log
SMB_LOG_DIR=/tmp/log/smb
CONTAINER_LOG_DIR=/var/log/samba
CONTAINER_LOG_HOST_PATH=/Volumes/RAMDisk/log/docker/samba
# 0 (minimal) to 10 (debug)
SMB_LOG_LEVEL=1
# KB per file before rotation
SMB_MAX_LOG_SIZE=10240


# --- Connections ---
# Concurrent clients server-wide; 0 = unlimited
SMB_CONCURRENT_CONNECTIONS=20
# Default per-share limit, overridable with SHARE_MAX_CONNECTIONS_<nth>; 0 = unlimited
SMB_MAX_CONNECTIONS=50
# Idle minutes before disconnect; 0 = never
SMB_DEADTIME=15
# Seconds
SMB_KEEPALIVE=300

# --- Resources ---
SMB_CPU_LIMIT=1.0
SMB_MEM_LIMIT=512M
SMB_MEM_RESERVATION=128M
SMB_PIDS_LIMIT=256
SMB_NOFILE_SOFT=16384
SMB_NOFILE_HARD=16384

# --- Share point 1: /onpremise ---
SHARE_NAME_1st=onpremise
SHARE_HOST_PATH_1st=/Volumes/RAMDisk/SMB
SHARE_CONTAINER_PATH_1st=/shares/onpremise
SHARE_COMMENT_1st=on-premise store
SHARE_MOUNT_READ_ONLY_1st=false
SHARE_READ_ONLY_1st=no
SHARE_BROWSEABLE_1st=yes
SHARE_GUEST_OK_1st=no
# Valid/read/write users and force user default to SMB_READ_USER/SMB_WRITE_USER
# in entrypoint.sh; left unset here so renaming those accounts can't desync.
SHARE_CREATE_MASK_1st=0664
SHARE_DIRECTORY_MASK_1st=0775
SHARE_MAX_CONNECTIONS_1st=50
SHARE_VETO_FILES_1st=/._*/.DS_Store/.Trashes/.TemporaryItems/
SHARE_DELETE_VETO_FILES_1st=yes

# --- Share 2: /Cloud ---
# Point to the real Cloud folder
SHARE_NAME_2nd=cloud
SHARE_HOST_PATH_2nd=/Users/Shared/Public/
SHARE_CONTAINER_PATH_2nd=/shares/cloud
SHARE_COMMENT_2nd=Cloud
SHARE_MOUNT_READ_ONLY_2nd=false
SHARE_READ_ONLY_2nd=no
SHARE_BROWSEABLE_2nd=yes
SHARE_GUEST_OK_2nd=no
# Valid/read/write users and force user default to SMB_READ_USER/SMB_WRITE_USER
# in entrypoint.sh; left unset here so renaming those accounts can't desync.
SHARE_CREATE_MASK_2nd=0664
SHARE_DIRECTORY_MASK_2nd=0775
SHARE_MAX_CONNECTIONS_2nd=50
SHARE_VETO_FILES_2nd=/._*/.DS_Store/.Trashes/.TemporaryItems/
SHARE_DELETE_VETO_FILES_2nd=yes
