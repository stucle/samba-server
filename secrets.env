# Credentials only. Keep it chmod 600 and out of version control.
#
# Every variable here reaches its process ONLY through `env_file:` of a compose service — none of them is interpolated into compose.yaml.
# That is why smb.sh does not need to pass this file to --env-file (see analyze-new-requirement.md §6.2),
# and why .dockerignore (`*` + `!entrypoint.sh` + `!smbctl`) already keeps it out of the build context.

# --- Samba accounts (read by entrypoint.sh inside smb-pod) ---
SMB_READ_PASSWORD=guest
SMB_WRITE_PASSWORD=IamGroot

# --- Admin API basic auth (read by the smb-admin service) ---
# Separate identity from the SMB accounts on purpose: changing SMB_WRITE_PASSWORD
# must not silently lock the Admin API out, and vice versa. The values currently
# coincide with the `groot` account; that is temporary, not a dependency.
ADMIN_API_USER=groot
ADMIN_API_PASSWORD=IamGroot
